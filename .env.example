# ---------------------------------------------------------------------------
# ClipForge configuration. Copy to .env and edit as needed.
# Every value has a sensible default; nothing here is strictly required.
# ---------------------------------------------------------------------------

# --- Paths --------------------------------------------------------------------
# Root folder where projects, uploads, transcripts and renders are stored.
CLIPFORGE_DATA_DIR=./data
# SQLite database file.
CLIPFORGE_DB_PATH=./data/clipforge.db

# --- Transcription ----------------------------------------------------------
# Backend: "faster-whisper" (default), "whisper.cpp", or "auto"
CLIPFORGE_WHISPER_BACKEND=auto
# Model size: tiny | base | small | medium | large-v3
CLIPFORGE_WHISPER_MODEL=small
# Device: auto | cpu | cuda   (Apple Silicon uses cpu int8 via CTranslate2)
CLIPFORGE_WHISPER_DEVICE=auto
# Compute type for faster-whisper: auto | int8 | int8_float16 | float16 | float32
CLIPFORGE_WHISPER_COMPUTE=auto
# Path to a whisper.cpp binary + model if you use that backend.
CLIPFORGE_WHISPERCPP_BIN=whisper-cli
CLIPFORGE_WHISPERCPP_MODEL=./models/ggml-small.bin
# Language hint ("auto" lets Whisper detect).
CLIPFORGE_WHISPER_LANGUAGE=auto

# --- Local LLM (Ollama) ----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Any locally installed chat model. Examples: qwen2.5:7b, llama3.1:8b, mistral:7b
MODEL_NAME=qwen2.5:7b
CLIPFORGE_LLM_TEMPERATURE=0.2
CLIPFORGE_LLM_MAX_TOKENS=1600
# If the LLM is unavailable, ClipForge still works using heuristic scoring only.
CLIPFORGE_LLM_REQUIRED=false

# --- Clip detection defaults ---------------------------------------------
CLIPFORGE_DEFAULT_CLIPS=5
# Auto lets the algorithm pick; or force one of 15/30/45/60/90
CLIPFORGE_DEFAULT_CLIP_LENGTH=auto
CLIPFORGE_MIN_CLIP_SECONDS=12
CLIPFORGE_MAX_CLIP_SECONDS=95
CLIPFORGE_BOUNDARY_PADDING=0.35

# --- Rendering ------------------------------------------------------------
CLIPFORGE_OUTPUT_WIDTH=1080
CLIPFORGE_OUTPUT_HEIGHT=1920
CLIPFORGE_OUTPUT_FPS=30
CLIPFORGE_VIDEO_CRF=18
CLIPFORGE_AUDIO_BITRATE=192k
CLIPFORGE_REFRAME_MODE=fit             # fit | smart_auto | center | face | speaker
CLIPFORGE_CAPTION_STYLE=bold           # clean | bold | karaoke | minimal | highlight
CLIPFORGE_ENHANCE_AUDIO=true
CLIPFORGE_USE_AI_HOOKS=true

# --- Worker / server ----------------------------------------------------
CLIPFORGE_WORKER_CONCURRENCY=1
CLIPFORGE_API_HOST=127.0.0.1
CLIPFORGE_API_PORT=8787
# Comma separated origins allowed to call the API (the Next.js dev server).
CLIPFORGE_CORS_ORIGINS=http://localhost:3000
